# Public site URL, used for canonical URLs, Open Graph, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Contact details shown across the site. LinkedIn and GitHub links appear only when set.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=

# Contact form delivery (https://resend.com). Without a key, development logs messages
# and production shows visitors a direct email fallback instead of pretending to send.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "Kelvin Ndoma <hello@your-domain.example>".
CONTACT_FROM_EMAIL=
# Inbox that receives enquiries. Defaults to NEXT_PUBLIC_CONTACT_EMAIL.
CONTACT_TO_EMAIL=
